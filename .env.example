# MOTORIST Blog + CMS Environment Configuration Template
# NOTE: Never commit sensitive credentials or secrets to source control.

# Database Connection (MySQL 8.0+)
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/motorist_blog?charset=utf8mb4"

# Admin Authentication & Sessions (Generate a 32+ character random secret)
AUTH_SECRET="CHANGE_ME_TO_A_SECURE_RANDOM_SECRET_KEY_32_CHARS"

# Cloudflare Turnstile Anti-Spam
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAA..."
TURNSTILE_SECRET_KEY="0x4AAAAAA..."

# Cloudflare R2 / S3 Object Storage (Production)
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="motorist-media"
R2_PUBLIC_DOMAIN="https://media.motoriststore.com"

# Cron Secret for Scheduled Releases
CRON_SECRET="CHANGE_ME_CRON_BEARER_SECRET"

# Node Environment
NODE_ENV="development"
